+        const auto clamped = std::clamp<int64_t>(micros, std::numeric_limits<int32_t>::min(),
+                                                 std::numeric_limits<int32_t>::max());
+        return static_cast<uint32_t>(static_cast<int32_t>(clamped));
+    }

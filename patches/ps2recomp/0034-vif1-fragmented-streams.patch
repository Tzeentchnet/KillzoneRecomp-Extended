From 2fb312fade7fc160eac6b9d22c110c0824764214 Mon Sep 17 00:00:00 2001
From: Tzeentchnet <58480142+Tzeentchnet@users.noreply.github.com>
Date: Wed, 11 Nov 2026 18:24:24 -0800
Subject: [PATCH] fix: preserve fragmented VIF1 command streams

---
 ps2xRuntime/include/runtime/ps2_memory.h     |   6 +-
 ps2xRuntime/src/lib/ps2_memory.cpp           |   6 +-
 ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp | 150 ++++++++++------
 ps2xTest/src/ps2_memory_tests.cpp            | 175 +++++++++++++++++++
 4 files changed, 274 insertions(+), 63 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ps2_memory.h b/ps2xRuntime/include/runtime/ps2_memory.h
index 4afdcbe..3f3e4e5 100644
--- a/ps2xRuntime/include/runtime/ps2_memory.h
+++ b/ps2xRuntime/include/runtime/ps2_memory.h
@@ -410,10 +410,8 @@ public:
     bool m_path3Masked = false;
     uint32_t m_vif1PendingPath2ImageQwc = 0u;
     bool m_vif1PendingPath2DirectHl = false;
-    // Remaining data qwords of a VIF1 DIRECT/DIRECTHL cut off by the end of a processVIF1Data() buffer; the next
-    // buffer starts with that raw data (no VIFcodes).
-    uint32_t m_vif1PendingDirectQwc = 0u;
-    bool m_vif1PendingDirectHl = false;
+    // Retains a VIFcode and its partial payload until the command can be applied atomically.
+    std::vector<uint8_t> m_vif1PendingPacket;
     std::vector<std::vector<uint8_t>> m_path3MaskedFifo;
 
     struct PendingTransfer
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
index 2d26738..1f7a43d 100644
--- a/ps2xRuntime/src/lib/ps2_memory.cpp
+++ b/ps2xRuntime/src/lib/ps2_memory.cpp
@@ -583,8 +583,7 @@ bool PS2Memory::initialize(size_t ramSize)
     m_path3MaskedFifo.clear();
     m_vif1PendingPath2ImageQwc = 0u;
     m_vif1PendingPath2DirectHl = false;
-    m_vif1PendingDirectQwc = 0u;
-    m_vif1PendingDirectHl = false;
+    m_vif1PendingPacket.clear();
     resetEeTimers();
 
     try
@@ -1673,8 +1672,7 @@ bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
                 std::memset(&vif1_regs, 0, sizeof(vif1_regs));
                 m_vif1PendingPath2ImageQwc = 0u;
                 m_vif1PendingPath2DirectHl = false;
-                m_vif1PendingDirectQwc = 0u;
-                m_vif1PendingDirectHl = false;
+                m_vif1PendingPacket.clear();
                 m_path3Masked = false;
                 if (wasPath3Masked)
                     flushMaskedPath3Packets();
diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index 867cbfd..8f22664 100644
--- a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
+++ b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
@@ -133,6 +133,47 @@ namespace
     // Bytes of source data per vector, by VN<<2|VL (PCSX2 nVifT).
     constexpr uint8_t kVifGsize[16] = {4, 2, 1, 0, 8, 4, 2, 0, 12, 6, 3, 0, 16, 8, 4, 2};
 
+    uint32_t vif1UnpackPayloadSize(uint8_t opcode, uint8_t num, uint32_t cycle, bool legacy)
+    {
+        const uint32_t vectorCount = (num == 0u) ? 256u : static_cast<uint32_t>(num);
+        if (!legacy)
+        {
+            const uint32_t cl = (cycle & 0xFFu) ? (cycle & 0xFFu) : 256u;
+            const uint32_t wl = ((cycle >> 8) & 0xFFu) ? ((cycle >> 8) & 0xFFu) : 256u;
+            const uint32_t sourceVectors =
+                (cl < wl) ? cl * (vectorCount / wl) + std::min(vectorCount % wl, cl) : vectorCount;
+            return (sourceVectors * kVifGsize[opcode & 0xFu] + 3u) & ~3u;
+        }
+
+        const uint8_t vn = static_cast<uint8_t>((opcode >> 2) & 0x3u);
+        const uint8_t vl = static_cast<uint8_t>(opcode & 0x3u);
+        const uint32_t components = static_cast<uint32_t>(vn) + 1u;
+        uint32_t bitsPerComponent = 32u;
+        if (vl == 1u)
+            bitsPerComponent = 16u;
+        else if (vl == 2u)
+            bitsPerComponent = 8u;
+        else if (vl == 3u)
+            bitsPerComponent = (vn == 3u) ? 4u : 16u;
+
+        const uint32_t bitsPerVector = (vl == 3u && vn == 3u) ? 16u : components * bitsPerComponent;
+        const uint32_t bytesPerVector = (bitsPerVector + 7u) / 8u;
+        uint32_t cl = cycle & 0xFFu;
+        uint32_t wl = (cycle >> 8) & 0xFFu;
+        if (cl == 0u)
+            cl = 1u;
+        if (wl == 0u)
+            wl = 1u;
+
+        uint32_t sourceVectors = vectorCount;
+        if (cl < wl)
+        {
+            const uint32_t fullBlocks = vectorCount / wl;
+            sourceVectors = fullBlocks * cl + std::min(vectorCount % wl, cl);
+        }
+        return (sourceVectors * bytesPerVector + 3u) & ~3u;
+    }
+
     // ---- UNPACK fast path ------------------------------------------------------------------------------------------
     // Plain UNPACK (no mask, STMOD 0, not fill mode: WL <= CL) is nearly all of Killzone's ~8700 UNPACKs per frame. The
     // generic loop below does per-element bounds checks and a per-field mask/mode switch for every quadword; here each
@@ -931,26 +972,19 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
             ps2Vif1StatMpg(same);
     };
 
-    uint32_t pos = 0;
+    std::vector<uint8_t> bufferedData;
+    if (!m_vif1PendingPacket.empty())
+    {
+        bufferedData.swap(m_vif1PendingPacket);
+        bufferedData.insert(bufferedData.end(), data, data + sizeBytes);
+        data = bufferedData.data();
+        sizeBytes = static_cast<uint32_t>(bufferedData.size());
+    }
 
+    uint32_t pos = 0;
     while (pos + 4u <= sizeBytes)
     {
-        if (m_vif1PendingDirectQwc != 0u)
-        {
-            // Continuation of a DIRECT that was cut off at the end of the previous buffer: raw GIF data, no VIFcodes.
-            const uint32_t availableQw = (sizeBytes - pos) / 16u;
-            if (availableQw == 0u)
-            {
-                break;
-            }
-
-            const uint32_t chunkQw = std::min<uint32_t>(m_vif1PendingDirectQwc, availableQw);
-            forwardVif1DirectData(data + pos, chunkQw * 16u, m_vif1PendingDirectHl);
-            pos += chunkQw * 16u;
-            m_vif1PendingDirectQwc -= chunkQw;
-            continue;
-        }
-
+        const uint32_t commandStart = pos;
         uint32_t cmd;
         memcpy(&cmd, data + pos, 4);
         pos += 4;
@@ -963,7 +997,30 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
         // Track most-recent command for VIFn_CODE emulation.
         vif1_regs.code = cmd;
         vif1_regs.num = num;
-        if (irq)
+
+        const bool unpack = (opcode & 0x60u) == 0x60u;
+        const bool hasPayload =
+            opcode == VIF_STMASK || opcode == VIF_STROW || opcode == VIF_STCOL ||
+            opcode == VIF_MPG || opcode == VIF_DIRECT || opcode == VIF_DIRECTHL || unpack;
+        uint32_t payloadBytes = 0u;
+        if (opcode == VIF_STMASK)
+            payloadBytes = 4u;
+        else if (opcode == VIF_STROW || opcode == VIF_STCOL)
+            payloadBytes = 16u;
+        else if (opcode == VIF_MPG)
+            payloadBytes = ((num == 0u) ? 256u : static_cast<uint32_t>(num)) * 8u;
+        else if (opcode == VIF_DIRECT || opcode == VIF_DIRECTHL)
+            payloadBytes = ((imm == 0u) ? 65536u : static_cast<uint32_t>(imm)) * 16u;
+        else if (unpack)
+            payloadBytes = vif1UnpackPayloadSize(opcode, num, vif1_regs.cycle, legacyVif1Unpack());
+
+        if (payloadBytes > sizeBytes - pos)
+        {
+            m_vif1PendingPacket.assign(data + commandStart, data + sizeBytes);
+            return;
+        }
+
+        if (irq && !hasPayload)
             vif1_regs.stat |= (1u << 11); // INT
 
         if (opcode == VIF_NOP)
@@ -1064,28 +1121,28 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
         }
         else if (opcode == VIF_STMASK)
         {
-            if (pos + 4 > sizeBytes)
-                break;
             uint32_t maskValue = 0;
             std::memcpy(&maskValue, data + pos, sizeof(maskValue));
             vif1_regs.mask = maskValue;
             pos += 4;
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else if (opcode == VIF_STROW)
         {
-            if (pos + 16 > sizeBytes)
-                break;
             std::memcpy(vif1_regs.row, data + pos, 16);
             pos += 16;
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else if (opcode == VIF_STCOL)
         {
-            if (pos + 16 > sizeBytes)
-                break;
             std::memcpy(vif1_regs.col, data + pos, 16);
             pos += 16;
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else if (opcode == VIF_MPG)
@@ -1094,45 +1151,25 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
             const uint32_t destAddr = (static_cast<uint32_t>(imm) * 8u) & (PS2_VU1_CODE_SIZE - 1u);
             const uint32_t instructionCount = (num == 0u) ? 256u : static_cast<uint32_t>(num);
             const uint32_t mpgBytes = instructionCount * 8u;
-            if (sizeBytes - pos < mpgBytes)
-                break;
 
             // The game re-sends microcode frequently. Identical uploads do not invalidate host VU programs.
             applyMpgUpload(destAddr, data + pos, mpgBytes);
             pos += mpgBytes;
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else if (opcode == VIF_DIRECT || opcode == VIF_DIRECTHL)
         {
-            uint32_t qwCount = imm;
-            if (qwCount == 0)
-                qwCount = 65536;
-            const uint32_t requestedQw = qwCount;
-            const uint32_t availableQw = (sizeBytes - pos) / 16u;
-            const bool truncated = qwCount > availableQw;
-            if (qwCount > availableQw)
-                qwCount = availableQw;
-
+            const uint32_t qwCount = (imm == 0u) ? 65536u : static_cast<uint32_t>(imm);
             const bool directHl = (opcode == VIF_DIRECTHL);
             count(st.vif1Direct);
-            count(st.vif1DirectQw, requestedQw);
-            if (truncated)
-            {
-                // The rest of this DIRECT's data starts the next buffer (see m_vif1PendingDirectQwc).
-                m_vif1PendingDirectQwc = requestedQw - qwCount;
-                m_vif1PendingDirectHl = directHl;
-            }
-            if (qwCount > 0)
-            {
-                forwardVif1DirectData(data + pos, qwCount * 16u, directHl);
-            }
+            count(st.vif1DirectQw, qwCount);
+            forwardVif1DirectData(data + pos, qwCount * 16u, directHl);
 
             pos += qwCount * 16;
-            if (truncated)
-            {
-                pos = sizeBytes;
-                break;
-            }
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else if ((opcode & 0x60) == 0x60)
@@ -1214,8 +1251,8 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
                         checkedUnpack(m_vu1Data, PS2_VU1_DATA_SIZE, vif1_regs, cmd, data + pos, srcBytes);
                 }
                 pos += srcBytes;
-                if (pos > sizeBytes)
-                    break;
+                if (irq)
+                    vif1_regs.stat |= (1u << 11);
                 continue;
             }
 
@@ -1418,8 +1455,8 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
             }
             pos += totalBytes;
 
-            if (pos > sizeBytes)
-                break;
+            if (irq)
+                vif1_regs.stat |= (1u << 11);
             continue;
         }
         else
@@ -1431,4 +1468,7 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
             continue;
         }
     }
+
+    if (pos < sizeBytes)
+        m_vif1PendingPacket.assign(data + pos, data + sizeBytes);
 }
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index 7f80288..925e534 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -498,6 +498,181 @@ void register_ps2_memory_tests()
                      "truncated MPG payload should not partially modify VU1 micro memory");
         });
 
+        tc.Run("VIF1 fixed payload resumes across DMA blocks", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "split fixed-payload fixture should initialize");
+
+            constexpr uint32_t kVif1Ch = 0x10009000u;
+            constexpr uint32_t kSource = 0x0002A000u;
+            const uint32_t blocks[][4] = {
+                {makeVifCmd(0x30u, 0u, 0u) | 0x80000000u,
+                 0x11111111u, 0x22222222u, 0x33333333u},
+                {0x44444444u, makeVifCmd(0x07u, 0u, 0xABCDu), 0u, 0u}
+            };
+            std::memcpy(mem.getRDRAM() + kSource, blocks, sizeof(blocks));
+
+            const auto transmit = [&](uint32_t source)
+            {
+                mem.writeIORegister(kVif1Ch + 0x10u, source);
+                mem.writeIORegister(kVif1Ch + 0x20u, 1u);
+                mem.writeIORegister(kVif1Ch, 0x100u);
+            };
+
+            transmit(kSource);
+            t.Equals(mem.vif1_regs.row[0], 0u, "incomplete STROW should not publish partial register data");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 0u,
+                     "I-bit should remain clear until the STROW payload completes");
+            t.Equals(mem.readIORegister(kVif1Ch + 0x20u), 0u,
+                     "the first DMA block should be consumed while its command remains pending");
+
+            transmit(kSource + 16u);
+            t.Equals(mem.vif1_regs.row[0], 0x11111111u, "split STROW should preserve row[0]");
+            t.Equals(mem.vif1_regs.row[1], 0x22222222u, "split STROW should preserve row[1]");
+            t.Equals(mem.vif1_regs.row[2], 0x33333333u, "split STROW should preserve row[2]");
+            t.Equals(mem.vif1_regs.row[3], 0x44444444u, "split STROW should preserve row[3]");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 1u << 11,
+                     "I-bit should assert after the STROW payload completes");
+            t.Equals(mem.vif1_regs.mark, 0xABCDu, "the command after split STROW should execute");
+        });
+
+        tc.Run("VIF1 MPG resumes atomically across input fragments", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "split MPG fixture should initialize");
+            std::memset(mem.getVU1Code(), 0xCD, PS2_VU1_CODE_SIZE);
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, makeVifCmd(0x4Au, 2u, 0x07FFu) | 0x80000000u);
+            for (uint32_t i = 0u; i < 16u; ++i)
+                packet.push_back(static_cast<uint8_t>(0x40u + i));
+            appendU32(packet, makeVifCmd(0x07u, 0u, 0x1234u));
+
+            mem.processVIF1Data(packet.data(), 12u);
+            const uint8_t *code = mem.getVU1Code();
+            t.Equals(static_cast<uint32_t>(code[PS2_VU1_CODE_SIZE - 1u]), 0xCDu,
+                     "incomplete MPG should not publish its first fragment");
+            t.Equals(static_cast<uint32_t>(code[0]), 0xCDu,
+                     "incomplete wrapping MPG should leave the start untouched");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 0u,
+                     "I-bit should remain clear while MPG is incomplete");
+
+            mem.processVIF1Data(packet.data() + 12u, static_cast<uint32_t>(packet.size()) - 12u);
+            bool wrapped = true;
+            for (uint32_t i = 0u; i < 8u; ++i)
+            {
+                wrapped &= code[PS2_VU1_CODE_SIZE - 8u + i] == static_cast<uint8_t>(0x40u + i);
+                wrapped &= code[i] == static_cast<uint8_t>(0x48u + i);
+            }
+            t.IsTrue(wrapped, "completed MPG should atomically wrap through VU1 micro memory");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 1u << 11,
+                     "I-bit should assert after MPG completes");
+            t.Equals(mem.vif1_regs.mark, 0x1234u, "the command after split MPG should execute");
+        });
+
+        tc.Run("VIF1 UNPACK resumes atomically across input fragments", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "split UNPACK fixture should initialize");
+            std::memset(mem.getVU1Data(), 0, PS2_VU1_DATA_SIZE);
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, makeVifCmd(0x6Cu, 2u, 3u) | 0x80000000u);
+            for (uint32_t i = 0u; i < 8u; ++i)
+                appendU32(packet, 0x10000000u + i);
+            appendU32(packet, makeVifCmd(0x07u, 0u, 0x5678u));
+
+            mem.processVIF1Data(packet.data(), 20u);
+            uint32_t first = 0xFFFFFFFFu;
+            std::memcpy(&first, mem.getVU1Data() + 3u * 16u, sizeof(first));
+            t.Equals(first, 0u, "incomplete UNPACK should not publish a partial vector");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 0u,
+                     "I-bit should remain clear while UNPACK is incomplete");
+
+            mem.processVIF1Data(packet.data() + 20u, static_cast<uint32_t>(packet.size()) - 20u);
+            bool unpacked = true;
+            for (uint32_t i = 0u; i < 8u; ++i)
+            {
+                uint32_t value = 0u;
+                std::memcpy(&value, mem.getVU1Data() + 3u * 16u + i * 4u, sizeof(value));
+                unpacked &= value == 0x10000000u + i;
+            }
+            t.IsTrue(unpacked, "completed UNPACK should preserve both vectors");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 1u << 11,
+                     "I-bit should assert after UNPACK completes");
+            t.Equals(mem.vif1_regs.mark, 0x5678u, "the command after split UNPACK should execute");
+        });
+
+        tc.Run("VIF1 DIRECT resumes inside a GIF quadword", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "split DIRECT fixture should initialize");
+
+            std::vector<std::vector<uint8_t>> captured;
+            mem.setGifPacketCallback([&](const uint8_t *data, uint32_t sizeBytes)
+            {
+                captured.emplace_back(data, data + sizeBytes);
+            });
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, makeVifCmd(0x50u, 0u, 1u) | 0x80000000u);
+            for (uint32_t i = 0u; i < 16u; ++i)
+                packet.push_back(static_cast<uint8_t>(0x80u + i));
+            appendU32(packet, makeVifCmd(0x07u, 0u, 0x9ABCu));
+
+            mem.processVIF1Data(packet.data(), 11u);
+            t.Equals(captured.size(), static_cast<size_t>(0u),
+                     "incomplete DIRECT should not submit a partial GIF packet");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 0u,
+                     "I-bit should remain clear while DIRECT is incomplete");
+
+            mem.processVIF1Data(packet.data() + 11u, static_cast<uint32_t>(packet.size()) - 11u);
+            t.Equals(captured.size(), static_cast<size_t>(1u),
+                     "completed DIRECT should submit exactly one GIF packet");
+            if (captured.size() == 1u)
+            {
+                t.Equals(captured[0].size(), static_cast<size_t>(16u),
+                         "completed DIRECT should preserve its declared size");
+                bool payloadMatches = captured[0].size() == 16u;
+                for (uint32_t i = 0u; payloadMatches && i < 16u; ++i)
+                    payloadMatches &= captured[0][i] == static_cast<uint8_t>(0x80u + i);
+                t.IsTrue(payloadMatches, "completed DIRECT should preserve bytes across the fragment");
+            }
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 1u << 11,
+                     "I-bit should assert after DIRECT completes");
+            t.Equals(mem.vif1_regs.mark, 0x9ABCu, "the command after split DIRECT should execute");
+        });
+
+        tc.Run("VIF1 retains partial command bytes and reset cancels pending data", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "partial command fixture should initialize");
+
+            std::vector<uint8_t> packet;
+            appendU32(packet, makeVifCmd(0x20u, 0u, 0u));
+            appendU32(packet, 0x89ABCDEFu);
+            appendU32(packet, makeVifCmd(0x07u, 0u, 0x2468u));
+            mem.processVIF1Data(packet.data(), 2u);
+            mem.processVIF1Data(packet.data() + 2u, static_cast<uint32_t>(packet.size()) - 2u);
+            t.Equals(mem.vif1_regs.mask, 0x89ABCDEFu, "split VIFcode bytes should retain the STMASK command");
+            t.Equals(mem.vif1_regs.mark, 0x2468u, "decoding should resume after the split VIFcode");
+
+            std::memset(mem.getVU1Code(), 0xCD, PS2_VU1_CODE_SIZE);
+            packet.clear();
+            appendU32(packet, makeVifCmd(0x4Au, 2u, 0u) | 0x80000000u);
+            packet.resize(packet.size() + 8u, 0x55u);
+            mem.processVIF1Data(packet.data(), static_cast<uint32_t>(packet.size()));
+            t.IsTrue(mem.writeIORegister(0x10003C10u, 1u), "VIF1 FBRST reset should succeed");
+
+            const uint32_t mark = makeVifCmd(0x07u, 0u, 0x1357u);
+            mem.processVIF1Data(reinterpret_cast<const uint8_t *>(&mark), sizeof(mark));
+            t.Equals(mem.vif1_regs.mark, 0x1357u, "reset should discard the stale MPG fragment");
+            t.Equals(static_cast<uint32_t>(mem.getVU1Code()[0]), 0xCDu,
+                     "cancelled MPG should leave VU1 micro memory untouched");
+            t.Equals(mem.vif1_regs.stat & (1u << 11), 0u,
+                     "reset should discard the pending command's I-bit");
+        });
+
         tc.Run("VIF UNPACK num zero uploads 256 vectors", [](TestCase &t)
         {
             PS2Memory mem;
-- 

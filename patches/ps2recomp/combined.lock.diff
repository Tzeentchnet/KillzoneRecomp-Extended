+        const uint32_t vn = vnvl >> 2;
+        const uint32_t elem = vnvl == 15u ? 2u : (4u >> (vnvl & 3u));
+        const uint32_t need = (vn == 2u) ? vsize + elem : vsize;
+        if (dataBytes < need)
+            return 0u;

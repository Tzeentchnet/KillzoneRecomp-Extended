+void PS2IopHostAdapter::drainPosted()
+{
+    // EE thread. Commands posted while this runs get their own wake-up event.
+    std::vector<PostedSifCommand> batch;
+    {
+        std::lock_guard<std::mutex> lock(m_postMutex);
+        batch.swap(m_posted);
+        m_postWakeQueued = false;
+    }
+    if (batch.empty())
+        return;

+    // Number of leading vectors handled (updates addr/vcl/src); 0 if none.
+    uint32_t unpackPlain(uint32_t vnvl, bool usn, uint8_t *vuMem, uint32_t vuMemSize, uint32_t &addr, uint32_t &vcl,

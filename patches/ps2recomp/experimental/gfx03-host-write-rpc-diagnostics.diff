+// Diagnostic observer for host-side writes into guest RAM (HLE stubs, IOP host transfers). May be called from the
+// IOP thread. Null (the default) costs one relaxed load. Hosts test PS2X_GUEST_RANGE_WRITE_OBSERVER before using it.
+#define PS2X_GUEST_RANGE_WRITE_OBSERVER 1
+using Ps2GuestRangeWriteObserver = void (*)(uint32_t guestAddr, uint32_t size, const char *op);
+inline std::atomic<Ps2GuestRangeWriteObserver> &ps2GuestRangeWriteObserver()
+{
+    static std::atomic<Ps2GuestRangeWriteObserver> observer{nullptr};
+    return observer;
+}
+
+// Diagnostic: describes an offloaded (threaded-IOP) nowait SifCallRpc whose receive buffer overlaps [lo, hi) and whose
+// result has not been copied back yet. Returns false when none does.
+struct Ps2RpcInFlightInfo
+{
+    uint32_t clientPtr = 0;
+    uint32_t sid = 0;
+    uint32_t rpcNum = 0;
+    uint32_t receiveBuffer = 0;
+    uint32_t receiveSize = 0;
+    uint32_t callerRa = 0;
+    uint64_t ageMicroseconds = 0;
+};
+bool ps2RpcFindInFlightReceive(uint32_t lo, uint32_t hi, Ps2RpcInFlightInfo &out);
+
 inline void ps2TraceGuestRangeWrite(uint8_t *rdram,

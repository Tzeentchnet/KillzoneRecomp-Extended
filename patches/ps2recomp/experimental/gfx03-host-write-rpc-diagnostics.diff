             uint32_t sendBuf = 0, sendSize = 0, receiveBuffer = 0, receiveSize = 0;
             uint32_t endFunction = 0, endParameter = 0, completionSemaphore = 0, gp = 0;
             uint32_t callerPc = 0, callerRa = 0;
+            uint64_t inFlightId = 0;
         };
 
+        // Diagnostic registry of offloaded nowait calls whose receive copy is still pending (ps2RpcFindInFlightReceive).
+        struct InFlightRpc
+        {
+            uint64_t id = 0;
+            Ps2RpcInFlightInfo info{};
+            std::chrono::steady_clock::time_point submitted{};
+        };
+        std::mutex g_inFlightMutex;
+        std::vector<InFlightRpc> g_inFlight;
+        uint64_t g_nextInFlightId = 1;
+
+        uint64_t registerInFlight(const OffloadedRpc &call)
+        {
+            std::lock_guard<std::mutex> lock(g_inFlightMutex);
+            InFlightRpc entry;
+            entry.id = g_nextInFlightId++;
+            entry.info.clientPtr = call.clientPtr;
+            entry.info.sid = call.sid;
+            entry.info.rpcNum = call.rpcNum;
+            entry.info.receiveBuffer = call.receiveBuffer & 0x1FFFFFFFu;
+            entry.info.receiveSize = call.receiveSize;
+            entry.info.callerRa = call.callerRa;
+            entry.submitted = std::chrono::steady_clock::now();
+            g_inFlight.push_back(entry);
+            return entry.id;
+        }
+
+        bool findInFlightReceive(uint32_t lo, uint32_t hi, Ps2RpcInFlightInfo &out)
+        {
+            std::lock_guard<std::mutex> lock(g_inFlightMutex);
+            const auto now = std::chrono::steady_clock::now();
+            for (const InFlightRpc &entry : g_inFlight)
+            {
+                const uint32_t begin = entry.info.receiveBuffer;
+                const uint32_t end = begin + entry.info.receiveSize;
+                if (entry.info.receiveSize == 0u || end <= lo || begin >= hi)
+                    continue;
+                out = entry.info;
+                out.ageMicroseconds = static_cast<uint64_t>(
+                    std::chrono::duration_cast<std::chrono::microseconds>(now - entry.submitted).count());
+                return true;
+            }
+            return false;
+        }
+
+        void unregisterInFlight(uint64_t id)
+        {
+            std::lock_guard<std::mutex> lock(g_inFlightMutex);
+            for (size_t i = 0; i < g_inFlight.size(); ++i)
+            {
+                if (g_inFlight[i].id == id)
+                {
+                    g_inFlight[i] = g_inFlight.back();
+                    g_inFlight.pop_back();
+                    return;
+                }
+            }
+        }
+

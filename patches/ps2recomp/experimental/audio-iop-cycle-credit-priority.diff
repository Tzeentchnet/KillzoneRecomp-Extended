+#if defined(_WIN32)
+        // The native PC port has cores to spare that the original hardware never had: this thread does fixed
+        // real-time work (SPU2 mixing) that must never wait behind the EE/render thread's load, so on a machine
+        // with enough logical processors it gets one physically reserved for it instead of just a priority hint.
+        // kz_main.cpp (the host executable, not this submodule) excludes the same bits from the main/EE thread's
+        // affinity by running the identical bit selection over the same process-wide GetProcessAffinityMask result;
+        // the two sides never communicate directly, they just compute the same deterministic answer independently.
+        DWORD_PTR reservedCoreMaskForProcess()
+        {
+            DWORD_PTR processMask = 0, systemMask = 0;
+            if (!GetProcessAffinityMask(GetCurrentProcess(), &processMask, &systemMask) || processMask == 0)
+                return 0;
+            int bits = 0;
+            for (DWORD_PTR m = processMask; m; m >>= 1)
+                bits += static_cast<int>(m & 1);
+            if (bits < 6) // leave small machines alone; reserving a whole core only pays off with headroom to spare
+                return 0;
+            DWORD_PTR reserved = 0;
+            int need = 2; // both logical processors of (assumed) one physical core, so no SMT sibling steals it
+            for (int i = static_cast<int>(sizeof(DWORD_PTR) * 8) - 1; i >= 0 && need > 0; --i)
+            {
+                const DWORD_PTR bit = static_cast<DWORD_PTR>(1) << i;
+                if (processMask & bit)
+                {
+                    reserved |= bit;
+                    --need;
+                }
+            }
+            return reserved;
+        }
+#endif

+bool EeScheduler::interruptsHeldOff(const R5900Context &context, const char *what, uint32_t detail)
+{
+    if (g_diGate == DiGateMode::Off || (context.cop0_status & kCop0StatusEie) != 0u)
+    {
+        m_diHoldStartCycle = 0u;
+        return false;
+    }
+    if (g_diGate == DiGateMode::Log)
+    {
+        if (m_diHeldDeliveries++ < 64u)
+        {
+            std::fprintf(stderr, "[ee-sched] di-gate(log): %s 0x%x delivered inside di at pc=0x%x ra=0x%x thread=%d\n", what,
+                         detail, context.pc, getRegU32(&context, 31), m_currentThreadId);
+        }
+        return false;
+    }
+    if (m_diHoldStartCycle == 0u)
+    {
+        m_diHoldStartCycle = std::max<uint64_t>(m_eeCycle, 1u);
+    }
+    else if (m_eeCycle - m_diHoldStartCycle > kEeClockHz / 20u)
+    {
+        // A guest that keeps `di` for 50 ms is not in a short critical section (or set Status some other way): deliver
+        // as before rather than starve every interrupt.
+        static bool warned = false;
+        if (!warned)
+        {
+            warned = true;
+            std::fprintf(stderr, "[ee-sched] di-gate: interrupts disabled for over 50 ms at pc=0x%x status=0x%x; delivering\n",
+                         context.pc, context.cop0_status);
+        }
+        return false;
+    }
+    ++m_diHeldDeliveries;
+    // `ei` is an inline Status write in generated code: keep the checkpoint flag raised so the guest yields at its next
+    // checkpoint and the held delivery happens right after it.
+    m_checkpointPending.store(true, std::memory_order_release);
+    return true;
+}

+    // Status.EIE gate. The EE takes no interrupt while Status.EIE is clear (`di`), so no interrupt handler, SIF or stream
+    // callback, and no thread switch that one of them (or the time slice) causes, may run inside a di/ei critical section.
+    // libkernel's timer-alarm list (SetTimerAlarm, used by DelayThread) is edited inside one while the TIM2 handler walks
+    // it; delivering the handler there corrupted the list (Killzone WIN-06). PS2X_DI_GATE=0 restores the old behaviour,
+    // PS2X_DI_GATE=log keeps it and reports the first deliveries the gate would have held back.
+    enum class DiGateMode
+    {
+        Off,
+        Log,
+        On,
+    };
+    const DiGateMode g_diGate = []() {
+        const char *v = std::getenv("PS2X_DI_GATE");
+        if (v && v[0] == '0')
+            return DiGateMode::Off;
+        if (v && std::string_view(v) == "log")
+            return DiGateMode::Log;
+        return DiGateMode::On;
+    }();
+    constexpr uint32_t kCop0StatusEie = 0x00010000u;
+
+    bool guestInterruptsDisabled(const R5900Context &context) noexcept
+    {
+        return g_diGate == DiGateMode::On && (context.cop0_status & kCop0StatusEie) == 0u;
+    }
 }
 
